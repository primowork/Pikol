// כרטיסיית ניקוב דיגיטלית - קפה פיקולו
// ראו /root/.claude/plans/zesty-dancing-hamming.md להסבר המלא על ההחלטות כאן.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  STAFF
}

enum StampEventType {
  STAMP
  REDEEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXPIRED
  DECLINED
}

// LOGIN: כניסה לכרטיס קיים ממכשיר חדש (טלפון רשום שהוזן ב-/join). נוצרת
// רק מ-POST /api/customers, לא מהנתיב הציבורי של בקשות האישור, ואישורה לא
// מוסיף ניקוב - רק מחזיר למכשיר המבקש את מזהה הכרטיס.
enum ApprovalRequestKind {
  STAMP
  REDEEM
  LOGIN
}

enum ConsentKind {
  TERMS_ACCEPTED
  MARKETING_OPT_IN
  MARKETING_OPT_OUT
}

// לקוח שנרשם למועדון. currentStamps הוא מקור האמת היחיד למספר הניקובים -
// הוא נכתב אך ורק דרך /api/stamps, לעולם לא ישירות מקלט של הלקוח.
//
// שדות הסכמה (termsAccepted/marketingOptIn/consentedAt/consentIp): המצב
// האחרון בלבד. נקבעים בהצטרפות לקוח חדש (POST /api/customers, כשנשלח גם
// name) - לקוח קיים שחוזר לא "מסכים" שוב בכל כניסה - ו-marketingOptIn
// משתנה אחר כך רק דרך setMarketingConsent (src/lib/consent.ts), שרושם גם
// שורה ב-ConsentEvent. consentedAt/consentIp מתעדכנים בכל הסכמה לדיוור.
model Customer {
  id                        String                     @id @default(cuid())
  name                      String
  phone                     String                     @unique
  birthday                  DateTime?                  @db.Date
  currentStamps             Int                        @default(0)
  rewardsEarned             Int                        @default(0)
  bonusRewardsAvailable     Int                        @default(0)
  lastBirthdayRewardYear    Int?
  /// מתי זוכתה מתנת יום ההולדת האחרונה. מתנה שלא מומשה פגה בסוף החודש של
  /// הזיכוי (src/lib/birthday-reward.ts). null במתנות מלפני הכלל הזה - הן לא פגות.
  birthdayRewardGrantedAt   DateTime?
  termsAccepted             Boolean                    @default(false)
  marketingOptIn            Boolean                    @default(false)
  consentedAt               DateTime?
  consentIp                 String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  stampEvents               StampEvent[]
  approvalRequests          ApprovalRequest[]
  customerPushSubscriptions CustomerPushSubscription[]
  consentEvents             ConsentEvent[]
}

// יומן הסכמות: כל הסכמה או הסרה של לקוח נרשמת כאן ולא נדרסת (השדות על
// Customer שומרים רק את המצב האחרון). בחוק הספאם נטל ההוכחה שהנמען הסכים
// הוא על המפרסם, כלומר על בית הקפה - זה התיעוד שלו.
model ConsentEvent {
  id           String      @id @default(cuid())
  customerId   String
  kind         ConsentKind
  /**
   * מאיפה: join | birthday | notifications | card | notification
   */
  source       String
  ip           String?
  /// ב-TERMS_ACCEPTED: איזו גרסה של תקנון המועדון אושרה (TERMS_VERSION ב-
  /// src/lib/config.ts). null בהסכמות מלפני שהתחלנו לשמור גרסה.
  termsVersion String?
  createdAt    DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// כרטיס שנמחק לבקשת הלקוח (DELETE /api/customers/[id], בעל העסק בלבד).
// הלקוח וכל מה שקשור אליו נמחקים; נשאר רק מספר הטלפון ויומן ההסכמות שלו,
// כדי שבית הקפה יוכל להראות שהייתה הסכמה אם תעלה טענה על דיוור. בלי שם,
// בלי יום הולדת ובלי ניקובים. מתועד בתקנון ובמדיניות הפרטיות (שבע שנים).
model DeletedCustomer {
  id               String   @id @default(cuid())
  phone            String
  /// העתק של שורות ConsentEvent של הלקוח: [{ kind, source, ip, termsVersion, createdAt }]
  consentHistory   Json
  customerSince    DateTime
  deletedAt        DateTime @default(now())
  deletedByStaffId String?

  @@index([phone])
}

// חבר צוות / בעל העסק. יכול להתחבר לדשבורד הניהול ולהוסיף ניקובים.
//
// email: לשחזור סיסמה בלבד (נקבע בעמוד ההגדרות, או OWNER_EMAIL ב-seed).
// sessionVersion: נשמר בתוך טוקן ה-session; איפוס או החלפת סיסמה מעלים
// אותו, וכל טוקן ישן (מכל מכשיר) מפסיק לעבוד - ראו getCurrentStaff.
model StaffUser {
  id                  String               @id @default(cuid())
  username            String               @unique
  email               String?              @unique
  passwordHash        String
  sessionVersion      Int                  @default(0)
  name                String
  role                StaffRole            @default(STAFF)
  createdAt           DateTime             @default(now())
  stampEvents         StampEvent[]
  pushSubscriptions   PushSubscription[]
  approvalResponses   ApprovalRequest[]
  passwordResetTokens PasswordResetToken[]
  broadcasts          Broadcast[]
}

// יומן שידורים ללקוחות: מה נשלח בדיוק, מתי, מי שלח, ומתי אישר שההודעה
// יוצאת בשם העסק ובאחריותו. staff עם Restrict כמו ב-StampEvent - לא מוחקים
// חבר צוות שיש לו היסטוריה.
model Broadcast {
  id             String   @id @default(cuid())
  staffId        String
  title          String
  body           String
  audienceCount  Int
  sentCount      Int
  failedCount    Int
  removedCount   Int
  acknowledgedAt DateTime
  createdAt      DateTime @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

// קישור איפוס סיסמה שנשלח במייל. נשמר רק hash של הטוקן (SHA-256) - מי
// שקורא את המסד לא יכול להשתמש בקישור. חד-פעמי: שימוש מוצלח מוחק את כל
// הקישורים של אותו חבר צוות.
model PasswordResetToken {
  id        String   @id @default(cuid())
  staffId   String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

// יומן ביקורת מלא: כל ניקוב וכל מימוש פרס נרשמים כאן לצמיתות, כולל מי
// מהצוות ביצע את הפעולה. זו ההגנה המרכזית נגד רמאויות - אין דרך לשנות
// את מספר הניקובים בלי שהפעולה תתועד כאן.
model StampEvent {
  id         String         @id @default(cuid())
  type       StampEventType
  customerId String
  staffId    String
  quantity   Int            @default(1)
  createdAt  DateTime       @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    StaffUser @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([customerId, type, createdAt])
  @@index([createdAt])
}

// בקשת ניקוב שנוצרת כשלקוח סורק את קוד ה-QR הקבוע בדוכן (לא ה-QR האישי
// שבכרטיס - זה קוד יחיד וקבוע לכל העסק, לא מכיל credential). אינה מקנה
// ניקוב בעצמה - רק "מבקשת" אחד. ההוספה בפועל קורית אך ורק דרך
// POST /api/approval-requests/[id]/approve, שדורש session מאומת של staff -
// staffId נגזר משם בדיוק כמו ב-POST /api/stamps הקיים, לעולם לא מהבקשה.
model ApprovalRequest {
  id                 String              @id @default(cuid())
  customerId         String
  status             ApprovalStatus      @default(PENDING)
  kind               ApprovalRequestKind @default(STAMP)
  quantity           Int                 @default(1)
  createdAt          DateTime            @default(now())
  respondedAt        DateTime?
  respondedByStaffId String?

  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  respondedByStaff StaffUser? @relation(fields: [respondedByStaffId], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt])
  @@index([status, createdAt])
}

// subscription ל-Web Push של מכשיר בודד. חבר צוות יכול להירשם מכמה
// מכשירים (יחס one-to-many) - כולם מקבלים את אותה התראה בכל בקשה.
model PushSubscription {
  id        String   @id @default(cuid())
  staffId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

// subscription ל-Web Push של לקוח (opt-in) - מודל נפרד מ-PushSubscription
// של הצוות כי הזהות/הרשאה שונות לגמרי: לקוח מזוהה ע"י ה-cuid הבלתי-נחוש
// שלו (כמו בכל endpoint ציבורי אחר), לא ע"י session מאומת. משמש לשידורים
// ידניים מהצוות (BroadcastToCustomers) ובעתיד לקמפיינים אוטומטיים.
model CustomerPushSubscription {
  id         String   @id @default(cuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

// טבלת הגדרות יחידה (singleton, id קבוע "singleton" בקוד - לא @default כאן
// כדי לא לסמוך על התנהגות schema-level למשהו שהוא ממילא מוסכמה
// אפליקטיבית). נערכת ע"י staff ב-/staff/settings. כל שדה אופציונלי -
// אם אין שורה, או שדה ספציפי ריק, הקוד נופל לברירת מחדל (טקסט קבוע ל-
// aboutUsText, משתנה הסביבה VAPID_SUBJECT ל-vapidSubject) - אין צורך
// במיגרציית seed. ראו src/lib/business-settings.ts.
//
// פרטי העסק (legalName...contactEmail): בית הקפה הוא בעל השליטה במאגר
// והמפרסם בשידורים, והפרטים שלו מוצגים במדיניות הפרטיות, בתנאי השימוש
// ובכרטיס - חובה בחוק הספאם ובחוק הגנת הפרטיות.
model BusinessSettings {
  id             String   @id
  aboutUsText    String?
  vapidSubject   String?
  legalName      String?
  businessNumber String?
  address        String?
  contactPhone   String?
  contactEmail   String?
  updatedAt      DateTime @updatedAt
}
