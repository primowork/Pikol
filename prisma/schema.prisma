// כרטיסיית ניקוב דיגיטלית - קפה פיקולו
// ראו /root/.claude/plans/zesty-dancing-hamming.md להסבר המלא על ההחלטות כאן.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  OWNER
  STAFF
}

enum StampEventType {
  STAMP
  REDEEM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXPIRED
  DECLINED
}

enum ApprovalRequestKind {
  STAMP
  REDEEM
}

// לקוח שנרשם למועדון. currentStamps הוא מקור האמת היחיד למספר הניקובים -
// הוא נכתב אך ורק דרך /api/stamps, לעולם לא ישירות מקלט של הלקוח.
//
// שדות הסכמה (termsAccepted/marketingOptIn/consentedAt/consentIp): נשמרים
// רק בהצטרפות לקוח חדש (POST /api/customers, כשנשלח גם name) - לקוח קיים
// שחוזר לא "מסכים" שוב בכל כניסה. consentedAt מתעדכן שוב אם הלקוח מסמן
// הסכמת שיווק מאוחר יותר (למשל בפופ-אפ יום ההולדת) אחרי שסירב בהצטרפות.
model Customer {
  id                        String                     @id @default(cuid())
  name                      String
  phone                     String                     @unique
  birthday                  DateTime?                  @db.Date
  currentStamps             Int                        @default(0)
  rewardsEarned             Int                        @default(0)
  termsAccepted             Boolean                    @default(false)
  marketingOptIn            Boolean                    @default(false)
  consentedAt               DateTime?
  consentIp                 String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  stampEvents               StampEvent[]
  approvalRequests          ApprovalRequest[]
  customerPushSubscriptions CustomerPushSubscription[]
}

// חבר צוות / בעל העסק. יכול להתחבר לדשבורד הניהול ולהוסיף ניקובים.
model StaffUser {
  id                String             @id @default(cuid())
  username          String             @unique
  passwordHash      String
  name              String
  role              StaffRole          @default(STAFF)
  createdAt         DateTime           @default(now())
  stampEvents       StampEvent[]
  pushSubscriptions PushSubscription[]
  approvalResponses ApprovalRequest[]
}

// יומן ביקורת מלא: כל ניקוב וכל מימוש פרס נרשמים כאן לצמיתות, כולל מי
// מהצוות ביצע את הפעולה. זו ההגנה המרכזית נגד רמאויות - אין דרך לשנות
// את מספר הניקובים בלי שהפעולה תתועד כאן.
model StampEvent {
  id         String         @id @default(cuid())
  type       StampEventType
  customerId String
  staffId    String
  quantity   Int            @default(1)
  createdAt  DateTime       @default(now())

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff    StaffUser @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([customerId, type, createdAt])
  @@index([createdAt])
}

// בקשת ניקוב שנוצרת כשלקוח סורק את קוד ה-QR הקבוע בדוכן (לא ה-QR האישי
// שבכרטיס - זה קוד יחיד וקבוע לכל העסק, לא מכיל credential). אינה מקנה
// ניקוב בעצמה - רק "מבקשת" אחד. ההוספה בפועל קורית אך ורק דרך
// POST /api/approval-requests/[id]/approve, שדורש session מאומת של staff -
// staffId נגזר משם בדיוק כמו ב-POST /api/stamps הקיים, לעולם לא מהבקשה.
model ApprovalRequest {
  id                 String              @id @default(cuid())
  customerId         String
  status             ApprovalStatus      @default(PENDING)
  kind               ApprovalRequestKind @default(STAMP)
  quantity           Int                 @default(1)
  createdAt          DateTime            @default(now())
  respondedAt        DateTime?
  respondedByStaffId String?

  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  respondedByStaff StaffUser? @relation(fields: [respondedByStaffId], references: [id], onDelete: SetNull)

  @@index([customerId, status, createdAt])
  @@index([status, createdAt])
}

// subscription ל-Web Push של מכשיר בודד. חבר צוות יכול להירשם מכמה
// מכשירים (יחס one-to-many) - כולם מקבלים את אותה התראה בכל בקשה.
model PushSubscription {
  id        String   @id @default(cuid())
  staffId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

// subscription ל-Web Push של לקוח (opt-in) - מודל נפרד מ-PushSubscription
// של הצוות כי הזהות/הרשאה שונות לגמרי: לקוח מזוהה ע"י ה-cuid הבלתי-נחוש
// שלו (כמו בכל endpoint ציבורי אחר), לא ע"י session מאומת. משמש לשידורים
// ידניים מהצוות (BroadcastToCustomers) ובעתיד לקמפיינים אוטומטיים.
model CustomerPushSubscription {
  id         String   @id @default(cuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}
