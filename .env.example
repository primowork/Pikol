# מסד הנתונים המקומי (קובץ SQLite). לפריסת production על פלטפורמת
# serverless (כמו Vercel) יש להחליף את זה בכתובת חיבור ל-Postgres/Turso -
# ראו הסבר ב-README.
DATABASE_URL="file:./dev.db"

# מפתח לחתימת session tokens של הצוות. ליצור ערך אקראי אמיתי עם:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# פרטי ההתחברות של בעל העסק (owner) שנוצרים אוטומטית בהרצה הראשונה של
# ה-seed script. יש להחליף את הסיסמה מיד לאחר הפריסה הראשונה.
OWNER_USERNAME="owner"
OWNER_PASSWORD="replace-me"
