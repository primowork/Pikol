# כתובת חיבור ל-Postgres. לפיתוח מקומי הכי קל להריץ Postgres דרך
# docker compose up -d (ראו docker-compose.yml) - הכתובת למטה תואמת לו
# מייד בלי שינוי. לפרודקשן משתמשים במסד נתונים מנוהל אמיתי (Postgres
# של Railway/Render/Neon/Supabase וכו') - ראו הסבר ב-README.
DATABASE_URL="postgresql://pikol:pikol@localhost:5432/pikol"

# מפתח לחתימת session tokens של הצוות. ליצור ערך אקראי אמיתי עם:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-a-real-random-secret"

# פרטי ההתחברות של בעל העסק (owner) שנוצרים אוטומטית בהרצה הראשונה של
# ה-seed script. יש להחליף את הסיסמה מיד לאחר הפריסה הראשונה (עמוד
# ההגדרות בדשבורד).
OWNER_USERNAME="owner"
OWNER_PASSWORD="replace-me"
# אופציונלי: מייל לשחזור סיסמה של ה-owner. נקבע רק אם עוד לא שמור מייל
# בחשבון (אפשר גם לקבוע ולשנות אותו בעמוד ההגדרות).
OWNER_EMAIL=""

# שליחת מיילים (קישור לאיפוס סיסמה) דרך Brevo. Railway חוסם SMTP בחבילות
# Free/Trial/Hobby, ולכן השליחה היא דרך ה-API שלהם ב-HTTPS. בחבילה
# החינמית מספיק לאמת כתובת שולח אחת (Senders), בלי דומיין. בלי שני
# המשתנים האלה, בפיתוח מקומי המייל מודפס ללוג השרת במקום להישלח.
BREVO_API_KEY=""
EMAIL_FROM=""

# אופציונלי: הכתובת הציבורית של האתר, לקישורים במיילים (בלי / בסוף).
# ב-Railway לא חובה - הדומיין נלקח אוטומטית מ-RAILWAY_PUBLIC_DOMAIN.
APP_URL=""

# מפתחות VAPID לחתימת הודעות Web Push (התראת "בקשת ניקוב" לצוות).
# ליצור זוג חד-פעמי עם:
#   npx web-push generate-vapid-keys
# ה-private key נשאר סודי בשרת בלבד. ה-public key נגזר ממנו אוטומטית, כך
# שהשורה שלו לא חובה; אם היא מוגדרת ולא תואמת, משתמשים בנגזר (אזהרה בלוג).
VAPID_PUBLIC_KEY="replace-with-generated-public-key"
VAPID_PRIVATE_KEY="replace-with-generated-private-key"

# כתובת קשר (mailto: או https://) שנשלחת לשירותי Web Push (FCM, אפל) בכל
# התראה, כחלק מסטנדרט VAPID. חייבת להיות כתובת אמיתית, בלי localhost או
# .local - אפל דוחה כל התראה לאייפון עם כתובת כזו. אפשר גם לקבוע אותה
# בעמוד ההגדרות בדשבורד (הערך שם קודם לזה).
VAPID_SUBJECT="mailto:replace-with-real-contact@example.com"
